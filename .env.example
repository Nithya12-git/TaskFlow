# ---------- backend/.env ----------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/taskflow?schema=public"
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"

# ---------- frontend/.env.local ----------
# Local development: talk to the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production (hosting): use the same domain and let Next.js forward /api to the backend.
#   NEXT_PUBLIC_API_URL=same-origin
#   API_URL=https://your-backend.example.com